<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
    <tool name="vop_cyclesmtlxsubnet" label="USD Cycles Material Builder" icon="$CYCLES_ICON">
        <toolMenuContext name="network">
            <contextOpType>Vop/materialbuilder</contextOpType>
        </toolMenuContext>
        <toolSubmenu>Cycles</toolSubmenu>
        <script scriptType="python"><![CDATA[
import voptoolutils
import hou
import os
mask = 'cycles ' + voptoolutils.USDPREVIEW_TAB_MASK
node = voptoolutils.createMaskedUsdPreviewSubnet(kwargs, 'cyclesmaterial', mask, 'USD Cycles Material Builder', 'cycles')

# Material settings like Blender's Material Properties > Settings (cycles_material_settings.py).
import cycles_material_settings
cycles_material_settings.add_settings(node)
]]></script>
    </tool>
    <tool name="lop_cycles_setup" label="Cycles (Setup)" icon="$CYCLES_ICON">
        <toolMenuContext name="viewer">
            <contextNetType>LOP</contextNetType>
        </toolMenuContext>
        <toolMenuContext name="network">
            <contextNetType>LOP</contextNetType>
        </toolMenuContext>
        <toolSubmenu>Cycles</toolSubmenu>
        <toolSubmenu>Rendering</toolSubmenu>
        <script scriptType="python"><![CDATA[
# Like Houdini's Karma (Setup) tool: Cycles Render Settings LOP and a USD Render ROP below it
# that renders those settings with Cycles.
import hou
import loptoolutils
node = loptoolutils.genericTool(kwargs, 'cyclesrendersettings')
nodename = node.name()
kwargs['inputnodename'] = nodename
kwargs['inputs'] = [(nodename, 0)]
kwargs['nodepositionx'] = str(node.position().x())
kwargs['nodepositiony'] = str(node.position().y() - 0.5)
rop = loptoolutils.genericTool(kwargs, 'usdrender_rop')
rop.parm('renderer').set('HdCyclesPlugin')
rop.parm('rendersettings').setExpression('chs("../%s/primpath")' % nodename)
rop.parm('husk_instantshutter').setExpression(
    '1 - ch("../%s/%s")' % (nodename, hou.text.encodeParm('cycles:integrator:motion_blur')))
node.setCurrent(True)
node.setSelected(True)
]]></script>
    </tool>
    <tool name="lop_cycles_bake_setup" label="Cycles Bake (Setup)" icon="$CYCLES_ICON">
        <toolMenuContext name="viewer">
            <contextNetType>LOP</contextNetType>
        </toolMenuContext>
        <toolMenuContext name="network">
            <contextNetType>LOP</contextNetType>
        </toolMenuContext>
        <toolSubmenu>Cycles</toolSubmenu>
        <toolSubmenu>Rendering</toolSubmenu>
        <script scriptType="python"><![CDATA[
# Texture baking setup: a Cycles Render Settings LOP that bakes the prim selected in the viewer
# (Bake panel), square resolution, Diffuse Color and Normal render vars, and a USD Render ROP.
import hou
import loptoolutils
node = loptoolutils.genericTool(kwargs, 'cyclesrendersettings', nodename='cyclesbake')
prim = ''
for viewer in hou.ui.paneTabs():
    if isinstance(viewer, hou.SceneViewer):
        selection = viewer.currentSceneGraphSelection()
        if selection:
            prim = str(selection[0])
            break
node.parm(hou.text.encodeParm('cycles:bake_object')).set(prim)
try:
    node.parm('res_mode').set('manual')
except hou.Error:
    pass
node.parmTuple('resolution').set((2048, 2048))
node.parm('picture').set('$HIP/render/bake_$OS.$F4.exr')
for name in ('aov_diffuse_color', 'aov_normal'):
    if node.parm(name):
        node.parm(name).set(True)
nodename = node.name()
kwargs['inputnodename'] = nodename
kwargs['inputs'] = [(nodename, 0)]
kwargs['nodepositionx'] = str(node.position().x())
kwargs['nodepositiony'] = str(node.position().y() - 0.5)
rop = loptoolutils.genericTool(kwargs, 'usdrender_rop')
rop.parm('renderer').set('HdCyclesPlugin')
rop.parm('rendersettings').setExpression('chs("../%s/primpath")' % nodename)
node.setCurrent(True)
node.setSelected(True)
]]></script>
    </tool>
</shelfDocument>
